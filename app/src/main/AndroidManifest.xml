<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
      Two reasons this app is online, both of them small. Shake-to-report posts the issue to
      GitHub, and the reverse geocoder turns the fix into a place name. Neither is on the
      recording path: with no network a clip is still recorded and still named, just named
      with its coordinates instead of a neighbourhood.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Coarse is enough. The title says which part of town you were in, not where you stood,
      and asking for fine location to write "Bastille, Paris" on a file would be asking for
      more than the feature needs.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      A recording that stops because the panel went dark is a lost moment, and this app exists
      to catch moments. The service holds the CPU awake for as long as the reels are turning.
    -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
      Putting a photograph on a tape label. Stills only: a label can never hold a clip, and asking
      for the video grant to choose a picture would be asking for someone's whole video library to
      decorate a cassette.
    -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <!--
      Sending a moment to a person rather than into whichever conversation happened to be open.
      BrightChat reads the `address` extra, which is the AOSP messaging convention, and turning a
      name into an address is the only thing this is for: the address book is read on this phone,
      held in memory, and never written anywhere or sent anywhere.

      Asked for at the picker rather than at launch. A recorder that wanted the address book on
      first run would be a recorder asking why, and most recordings are never sent to anybody.
    -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!--
      Roll's read-only list of the photographs you starred, so the picker can offer them on their
      own. Package visibility on API 30+ is opt-in, and without this the query silently returns
      nothing and the filter never appears. Named rather than a broad provider query, so this can
      see Roll and nothing else.
    -->
    <queries>
        <package android:name="com.gios.lightcamera" />
        <!--
            BrightChat, so a moment can be sent straight into a conversation rather than through a
            chooser. Package visibility on API 30+ is opt-in: without this, resolving an explicit
            intent at BrightChat finds nothing on a phone that has it installed, and the send falls
            back to a chooser for no reason.
        -->
        <package android:name="com.gios.lightchat" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.BrightRecorder">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.BrightRecorder">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          One service for both directions of the tape. Recording and playing are never both
          happening, and a single service means one notification, one wake lock and one
          lifecycle to reason about instead of two that have to agree about who owns the
          audio device.
        -->
        <service
            android:name=".service.TapeService"
            android:exported="false"
            android:foregroundServiceType="microphone|mediaPlayback" />

        <!--
            Handing a moment to another app.

            A recording lives in this app's private storage, so a share cannot pass a file path: the
            receiving app has no permission to read it and the URI would resolve to nothing. A
            FileProvider issues a content:// URI instead, and the grant rides on the intent — read
            only, one clip at a time, revoked when the receiver is done with it.

            `grantUriPermissions` is what makes that work at all, and the paths it may serve are
            listed in `shared_clips.xml` rather than being the whole directory.
        -->
        <!--
          What was recorded on a day, for BrightNotebook's timeline. Tapes live in this app's
          filesDir, so a provider is the only way across the boundary; the same day the notebook
          draws out of where you were and what you played can now say that you recorded something
          at half past two and how long it ran. Exported with no permission, like the collection's
          other bridges — see share/ClipsProvider.kt for why, and for the two path checks that
          stop a filename from another process naming anything but a clip.
        -->
        <provider
            android:name=".share.ClipsProvider"
            android:authorities="com.gios.brightrecorder.clips"
            android:exported="true" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.clips"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/shared_clips" />
        </provider>

    </application>
</manifest>
